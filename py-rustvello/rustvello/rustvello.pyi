# ============================================================================
# Exception classes
# ============================================================================

class RustvelloError(Exception): ...
class BrokerError(RustvelloError): ...
class ConfigurationError(RustvelloError): ...
class InternalError(RustvelloError): ...
class InvocationError(RustvelloError): ...

class InvocationNotFoundError(InvocationError):
    invocation_id: str

class InvocationStatusError(InvocationError): ...

class StatusOwnershipError(InvocationStatusError):
    invocation_id: str
    from_status: str
    to_status: str
    current_owner: str
    attempted_owner: str
    reason: str

class StatusRaceConditionError(InvocationStatusError):
    invocation_id: str
    previous_status: str
    expected_status: str
    actual_status: str

class StatusTransitionError(InvocationStatusError):
    invocation_id: str
    from_status: str
    to_status: str
    allowed_statuses: list[str]

class RetryError(RustvelloError): ...
class ConcurrencyRetryError(RetryError): ...
class RunnerError(RustvelloError): ...
class SerializationError(RustvelloError): ...
class StateBackendError(RustvelloError): ...
class TaskError(RustvelloError): ...
class CycleDetectedError(TaskError): ...
class RunnerNotExecutableError(TaskError): ...
class TaskClassNotFoundError(TaskError): ...
class TaskNotFoundError(TaskError): ...
class TaskNotRegisteredError(TaskError): ...
