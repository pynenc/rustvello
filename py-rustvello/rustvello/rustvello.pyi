# Status & Concurrency
# ============================================================================

class InvocationStatus:
    @staticmethod
    def registered() -> InvocationStatus: ...
    @staticmethod
    def pending() -> InvocationStatus: ...
    @staticmethod
    def running() -> InvocationStatus: ...
    @staticmethod
    def success() -> InvocationStatus: ...
    @staticmethod
    def failed() -> InvocationStatus: ...
    @staticmethod
    def retry() -> InvocationStatus: ...
    @staticmethod
    def concurrency_controlled() -> InvocationStatus: ...
    @staticmethod
    def concurrency_controlled_final() -> InvocationStatus: ...
    @staticmethod
    def rerouted() -> InvocationStatus: ...
    @staticmethod
    def pending_recovery() -> InvocationStatus: ...
    @staticmethod
    def running_recovery() -> InvocationStatus: ...
    def is_terminal(self) -> bool: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class ConcurrencyControlType:
